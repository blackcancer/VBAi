<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VBAi.Updater</AssemblyName><RootNamespace>CodexVBE</RootNamespace>
    <ApplicationIcon>../../assets/icons/assistant.ico</ApplicationIcon>
    <OutputPath Condition="'$(BuildOutputRoot)' == ''">$(RepositoryRoot)bin/$(Configuration)/updater/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CodexVBE/Updates/WebViewRuntimePrerequisite.cs" Link="WebViewRuntimePrerequisite.cs" />
    <Reference Include="System.Net.Http" />
    <Compile Include="../CodexVBE/Updates/UpdatePaths.cs" Link="UpdatePaths.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateRelease.cs" Link="UpdateRelease.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateInstallJob.cs" Link="UpdateInstallJob.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateInstallerRunner.cs" Link="UpdateInstallerRunner.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateProgressWindow.cs" Link="UpdateProgressWindow.cs"><SubType>Code</SubType></Compile>
    <Compile Include="../CodexVBE/Updates/UpdateProgressWindow.Designer.cs" Link="UpdateProgressWindow.Designer.cs"><SubType>Code</SubType><DependentUpon>UpdateProgressWindow.cs</DependentUpon></Compile>
    <Compile Include="../CodexVBE/Updates/UpdateText.cs" Link="UpdateText.cs" />
    <Compile Include="../CodexVBE/Localization/UiLanguages.cs" Link="UiLanguages.cs" />
    <Compile Include="../CodexVBE/Ui/UiTheme.cs" Link="UiTheme.cs" />
    <EmbeddedResource Include="../CodexVBE/Localization/UiStrings*.resx" Link="Localization\%(Filename)%(Extension)"><LogicalName>CodexVBE.Localization.%(Filename).resources</LogicalName></EmbeddedResource>
    <Reference Include="System.Web.Extensions" /><Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- The editable resource belongs to the main project; compile it without a second Designer hierarchy. -->
  <Target Name="IncludeProgressResource" BeforeTargets="PrepareResources" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup><EmbeddedResource Include="../CodexVBE/Updates/UpdateProgressWindow.resx"><LogicalName>CodexVBE.UpdateProgressWindow.resources</LogicalName></EmbeddedResource></ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup><Compile Update="../CodexVBE/Updates/UpdateProgressWindow*.cs"><SubType>Code</SubType></Compile></ItemGroup>
</Project>
