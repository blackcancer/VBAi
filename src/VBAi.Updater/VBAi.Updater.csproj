<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VBAi.Updater</AssemblyName><RootNamespace>CodexVBE</RootNamespace>
    <ApplicationIcon>../../assets/icons/assistant.ico</ApplicationIcon>
    <OutputPath Condition="'$(BuildOutputRoot)' == ''">$(RepositoryRoot)bin/$(Configuration)/updater/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CodexVBE/Updates/WebViewRuntimePrerequisite.cs" Link="WebViewRuntimePrerequisite.cs" />
    <Reference Include="System.Net.Http" />
    <Compile Include="../CodexVBE/Updates/UpdatePaths.cs" Link="UpdatePaths.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateRelease.cs" Link="UpdateRelease.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateInstallJob.cs" Link="UpdateInstallJob.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateInstallerRunner.cs" Link="UpdateInstallerRunner.cs" />
    <Compile Include="../CodexVBE/Updates/UpdateProgressWindow.cs" Link="UpdateProgressWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Include="../CodexVBE/Updates/UpdateProgressWindow.Designer.cs" Link="UpdateProgressWindow.Designer.cs"><DependentUpon>UpdateProgressWindow.cs</DependentUpon></Compile>
    <Compile Include="../CodexVBE/Updates/UpdateText.cs" Link="UpdateText.cs" />
    <Compile Include="../CodexVBE/Localization/UiLanguages.cs" Link="UiLanguages.cs" />
    <Compile Include="../CodexVBE/Ui/UiTheme.cs" Link="UiTheme.cs" />
    <EmbeddedResource Include="../CodexVBE/Updates/UpdateProgressWindow.resx" Link="UpdateProgressWindow.resx"><DependentUpon>UpdateProgressWindow.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Include="../CodexVBE/Localization/UiStrings*.resx"><LogicalName>CodexVBE.Localization.%(Filename).resources</LogicalName></EmbeddedResource>
    <Reference Include="System.Web.Extensions" /><Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
