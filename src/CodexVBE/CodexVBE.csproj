<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Preserve the CodeBase path registered by the installer. -->
    <OutputPath Condition="'$(BuildOutputRoot)' == ''">$(RepositoryRoot)bin\$(Configuration)\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <EmbeddedResource Include="..\..\assets\icons\assistant.ico" Link="Resources\Icons\assistant.ico" LogicalName="CodexVBE.Icons.assistant.ico" />
    <EmbeddedResource Include="..\..\assets\icons\github.ico" Link="Resources\Icons\github.ico" LogicalName="CodexVBE.Icons.github.ico" />
    <EmbeddedResource Include="..\..\assets\icons\settings.ico" Link="Resources\Icons\settings.ico" LogicalName="CodexVBE.Icons.settings.ico" />
    <EmbeddedResource Include="..\..\assets\icons\github.png" Link="Resources\Icons\github.png" LogicalName="CodexVBE.Icons.github.png" />
    <EmbeddedResource Include="..\..\assets\icons\settings.png" Link="Resources\Icons\settings.png" LogicalName="CodexVBE.Icons.settings.png" />
    <Compile Include="**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <Compile Update="Git\GitHubPane.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Git\GitHubPane.Designer.cs"><DependentUpon>GitHubPane.cs</DependentUpon></Compile>
    <Compile Update="Ui\CodeDiffView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Ui\CodeDiffView.Designer.cs"><DependentUpon>CodeDiffView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Localization\*.resx"><LogicalName>CodexVBE.Localization.%(Filename).resources</LogicalName></EmbeddedResource>
    <Compile Update="Git\GitWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Git\GitWindow.Designer.cs"><DependentUpon>GitWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Chat\ChatWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Chat\ChatWindow.Designer.cs"><DependentUpon>ChatWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Chat\VbeApprovalDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Chat\VbeApprovalDialog.Designer.cs"><DependentUpon>VbeApprovalDialog.cs</DependentUpon></Compile>
    <Compile Update="Llm\Settings\LlmSettingsWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Settings\LlmSettingsWindow.Designer.cs"><DependentUpon>LlmSettingsWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Git\GitWindow.resx"><DependentUpon>GitWindow.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="Llm\Chat\ChatWindow.resx"><DependentUpon>ChatWindow.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="Llm\Settings\LlmSettingsWindow.resx"><DependentUpon>LlmSettingsWindow.cs</DependentUpon></EmbeddedResource>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="Accessibility" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
</Project>
