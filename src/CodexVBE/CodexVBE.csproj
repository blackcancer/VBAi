<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <NativeRendererOutput>$(MSBuildProjectDirectory)\obj\native\$(Configuration)</NativeRendererOutput>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Preserve the CodeBase path registered by the installer. -->
    <OutputPath Condition="'$(BuildOutputRoot)' == ''">$(RepositoryRoot)bin\$(Configuration)\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Standard Designer image resources also compile with the .NET SDK resource generator. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup><ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion></PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute"><_Parameter1>$(ProductVersion)</_Parameter1></AssemblyAttribute>
    <ProjectReference Include="../VBAi.Updater/VBAi.Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="WriteProductVersion" BeforeTargets="CoreCompile">
    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)VbaProductVersion.g.cs" AssemblyAttributes="@(AssemblyAttribute)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)VbaProductVersion.g.cs" /></ItemGroup>
  </Target>
  <Target Name="CopyUpdateProgram" AfterTargets="Build">
    <MSBuild Projects="../VBAi.Updater/VBAi.Updater.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)"><Output TaskParameter="TargetOutputs" ItemName="_UpdateProgram" /></MSBuild>
    <Copy SourceFiles="@(_UpdateProgram)" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="@(_UpdateProgram->'%(FullPath).config')" DestinationFolder="$(TargetDir)" Condition="Exists('@(_UpdateProgram->'%(FullPath).config')')" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(NativeRendererOutput)\CodexVBE.Native.dll" LogicalName="CodexVBE.Native.Renderer.dll" />
    <NativeRendererSource Include="..\CodexVBE.Native\*.cpp;..\CodexVBE.Native\*.h;..\..\tools\build\Build-NativeRenderer.ps1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Content Include="..\..\assets\editor\dist\**\*" Link="EditorAssets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <EmbeddedResource Include="..\..\assets\icons\assistant.ico" Link="Resources\Icons\assistant.ico" LogicalName="CodexVBE.Icons.assistant.ico" />
    <EmbeddedResource Include="..\..\assets\icons\github.ico" Link="Resources\Icons\github.ico" LogicalName="CodexVBE.Icons.github.ico" />
    <EmbeddedResource Include="..\..\assets\icons\settings.ico" Link="Resources\Icons\settings.ico" LogicalName="CodexVBE.Icons.settings.ico" />
    <EmbeddedResource Include="..\..\assets\icons\github.png" Link="Resources\Icons\github.png" LogicalName="CodexVBE.Icons.github.png" />
    <EmbeddedResource Include="..\..\assets\icons\settings.png" Link="Resources\Icons\settings.png" LogicalName="CodexVBE.Icons.settings.png" />
    <Compile Include="**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <Compile Update="Updates\UpdateProgressWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Updates\UpdateProgressWindow.Designer.cs"><SubType>Code</SubType><DependentUpon>UpdateProgressWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Updates\UpdateProgressWindow.resx"><DependentUpon>UpdateProgressWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Updates\UpdateWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Updates\UpdateWindow.Designer.cs"><DependentUpon>UpdateWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Updates\UpdateWindow.resx"><DependentUpon>UpdateWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Editor\ModernEditorWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Editor\ModernEditorWindow.Designer.cs"><DependentUpon>ModernEditorWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Editor\ModernEditorWindow.resx"><DependentUpon>ModernEditorWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Settings\Views\*.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Settings\Views\*.Designer.cs"><SubType>Code</SubType><DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Settings\Views\*.resx"><DependentUpon>%(Filename).cs</DependentUpon></EmbeddedResource>
    <Compile Update="Git\Views\*.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Git\Views\*.Designer.cs"><SubType>Code</SubType><DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon></Compile>
    <EmbeddedResource Update="Git\Views\*.resx"><DependentUpon>%(Filename).cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\*View.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\*View.Designer.cs"><SubType>Code</SubType><DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\*View.resx"><DependentUpon>%(Filename).cs</DependentUpon></EmbeddedResource>
    <Compile Update="Host\ChatToolWindow.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Host\ChatToolWindow.Designer.cs"><DependentUpon>ChatToolWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Host\ChatToolWindow.resx"><DependentUpon>ChatToolWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Git\GitHubPane.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Git\GitHubPane.Designer.cs"><DependentUpon>GitHubPane.cs</DependentUpon></Compile>
    <Compile Update="Ui\CrashReportWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Ui\CrashReportWindow.Designer.cs"><DependentUpon>CrashReportWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Ui\CrashReportWindow.resx"><DependentUpon>CrashReportWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Ui\AboutWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Ui\AboutWindow.Designer.cs"><DependentUpon>AboutWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Ui\AboutWindow.resx"><DependentUpon>AboutWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Ui\CodeDiffView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Ui\CodeDiffView.Designer.cs"><DependentUpon>CodeDiffView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Localization\*.resx"><LogicalName>CodexVBE.Localization.%(Filename).resources</LogicalName></EmbeddedResource>
    <Compile Update="Git\GitWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Git\GitWindow.Designer.cs"><DependentUpon>GitWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Chat\ChatQueuedMessageView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Chat\ChatQueuedMessageView.Designer.cs"><DependentUpon>ChatQueuedMessageView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Chat\ChatQueuedMessageView.resx"><DependentUpon>ChatQueuedMessageView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatLinkView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatLinkView.Designer.cs"><DependentUpon>ChatLinkView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatLinkView.resx"><DependentUpon>ChatLinkView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatTextContentView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatTextContentView.Designer.cs"><DependentUpon>ChatTextContentView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatTextContentView.resx"><DependentUpon>ChatTextContentView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatDisclosureView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatDisclosureView.Designer.cs"><DependentUpon>ChatDisclosureView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatDisclosureView.resx"><DependentUpon>ChatDisclosureView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatMessageView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatMessageView.Designer.cs"><DependentUpon>ChatMessageView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatMessageView.resx"><DependentUpon>ChatMessageView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatAttachmentView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatAttachmentView.Designer.cs"><DependentUpon>ChatAttachmentView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatAttachmentView.resx"><DependentUpon>ChatAttachmentView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatActivityGroupView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatActivityGroupView.Designer.cs"><DependentUpon>ChatActivityGroupView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatActivityGroupView.resx"><DependentUpon>ChatActivityGroupView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatActivityStepView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatActivityStepView.Designer.cs"><DependentUpon>ChatActivityStepView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatActivityStepView.resx"><DependentUpon>ChatActivityStepView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatChangeCardView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatChangeCardView.Designer.cs"><DependentUpon>ChatChangeCardView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatChangeCardView.resx"><DependentUpon>ChatChangeCardView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatFormRecoveryView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatFormRecoveryView.Designer.cs"><DependentUpon>ChatFormRecoveryView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatFormRecoveryView.resx"><DependentUpon>ChatFormRecoveryView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatWelcomeView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatWelcomeView.Designer.cs"><DependentUpon>ChatWelcomeView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatWelcomeView.resx"><DependentUpon>ChatWelcomeView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Controls\Transcript\ChatSuggestionsView.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatSuggestionsView.Designer.cs"><DependentUpon>ChatSuggestionsView.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Controls\Transcript\ChatSuggestionsView.resx"><DependentUpon>ChatSuggestionsView.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Chat\ChatWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Chat\ChatWindow.Designer.cs"><DependentUpon>ChatWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Chat\VbeApprovalDialog.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Chat\ProjectAccessWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Chat\ProjectAccessWindow.Designer.cs"><DependentUpon>ProjectAccessWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Llm\Chat\ProjectAccessWindow.resx"><DependentUpon>ProjectAccessWindow.cs</DependentUpon></EmbeddedResource>
    <Compile Update="Llm\Chat\VbeApprovalDialog.Designer.cs"><DependentUpon>VbeApprovalDialog.cs</DependentUpon></Compile>
    <Compile Update="Llm\Settings\LlmSettingsWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Llm\Settings\LlmSettingsWindow.Designer.cs"><DependentUpon>LlmSettingsWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Git\GitWindow.resx"><DependentUpon>GitWindow.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="Llm\Chat\ChatWindow.resx"><DependentUpon>ChatWindow.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="Llm\Settings\LlmSettingsWindow.resx"><DependentUpon>LlmSettingsWindow.cs</DependentUpon></EmbeddedResource>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="Accessibility" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
  <Target Name="BuildNativeRenderer" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(NativeRendererSource)"
          Outputs="$(NativeRendererOutput)\CodexVBE.Native.dll">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)tools\build\Build-NativeRenderer.ps1&quot; -OutputDirectory &quot;$(NativeRendererOutput)&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Override Visual Studio subtype inference persisted in the user project file. -->
  <ItemGroup>
    <Compile Update="Editor\ModernEditorWindow.*.cs"><SubType>Code</SubType><DependentUpon>ModernEditorWindow.cs</DependentUpon></Compile>
    <Compile Update="Git\GitWindow.*.cs"><SubType>Code</SubType><DependentUpon>GitWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Settings\LlmSettingsWindow.*.cs"><SubType>Code</SubType><DependentUpon>LlmSettingsWindow.cs</DependentUpon></Compile>
    <Compile Update="Llm\Chat\ChatWindow.*.cs"><SubType>Code</SubType><DependentUpon>ChatWindow.cs</DependentUpon></Compile>
    <Compile Update="**\*.Designer.cs"><SubType>Code</SubType></Compile>
    <Compile Update="Git\GitHubPane.*.cs"><SubType>Code</SubType><DependentUpon>GitHubPane.cs</DependentUpon></Compile>
    <Compile Update="Llm\Controls\Transcript\ChatDesignerView.cs"><SubType>Code</SubType></Compile>
  </ItemGroup>
</Project>
