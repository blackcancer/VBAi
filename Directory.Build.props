<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <HelpOutputRoot Condition="'$(HelpOutputRoot)' == ''">$(RepositoryRoot)dist/help/</HelpOutputRoot>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Optional isolated build; keep a distinct output directory per project. -->
    <BaseOutputPath Condition="'$(BuildOutputRoot)' != ''">$(BuildOutputRoot)\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- Keep the documentation tool's generated files out of the tools source tree. -->
    <BaseOutputPath Condition="'$(BuildOutputRoot)' == '' and '$(MSBuildProjectName)' == 'XmlDocumentationAudit'">$(RepositoryRoot)artifacts\build\XmlDocumentationAudit\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'XmlDocumentationAudit'">$(RepositoryRoot)artifacts\obj\XmlDocumentationAudit\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'VBAi' or '$(MSBuildProjectName)' == 'VBAi.Updater'">
    <Content Include="$(RepositoryRoot)LICENSE" Link="Licenses/MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)LICENSES/MIT.txt" Link="Licenses/MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)LICENSING.md" Link="Licenses/Scope.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
